# Copiez en secrets.yml, remplissez, puis chiffrez :
#   ansible-vault encrypt secrets.yml
# Ne commitez JAMAIS secrets.yml non chiffré (il est dans .gitignore).

secrets:
  unitaire:
    aws_access_key: "AKIA..."
    aws_secret_key: "..."
    ssh_cle_privee: |
      -----BEGIN OPENSSH PRIVATE KEY-----
      ...
      -----END OPENSSH PRIVATE KEY-----
    rancher_bootstrap_password: "un-mot-de-passe-long-unitaire"
  prod:
    # Utilisateur IAM DISTINCT, limité aux ressources de la prod
    aws_access_key: "AKIA..."
    aws_secret_key: "..."
    ssh_cle_privee: |
      -----BEGIN OPENSSH PRIVATE KEY-----
      ...
      -----END OPENSSH PRIVATE KEY-----
    rancher_bootstrap_password: "un-autre-mot-de-passe-long-prod"
